#: model:ir.model.fields,field_description:l10n_ar_arca_edi.field_account_move__l10n_ar_arca_edi_enabled
msgid "Issues electronic invoice (WSFEv1)"
msgstr "Emite factura electrónica (WSFEv1)"

#. module: l10n_ar_arca_edi
#: model:ir.model,name:l10n_ar_arca_edi.model_account_journal
msgid "Journal"
msgstr "Diario"

#. module: l10n_ar_arca_edi
#: model:ir.model,name:l10n_ar_arca_edi.model_account_move
msgid "Journal Entry"
msgstr "Asiento contable"

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "Numbering in sync: the last one authorized by ARCA and the last local one are the same (%(nro)s)."
msgstr "Numeración sincronizada: el último autorizado en ARCA y el último local son el mismo (%(nro)s)."

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "Numbering out of sync for %(journal)s / %(doc_type)s: the last one authorized by ARCA is %(arca)s and the last local one is %(local)s. A manual adjustment is required before invoicing again in this journal."
msgstr "Numeración desincronizada para %(journal)s / %(doc_type)s: el último autorizado en ARCA es %(arca)s y el último local es %(local)s. Se requiere un ajuste manual antes de seguir facturando en este diario."

#. module: l10n_ar_arca_edi
#: model:ir.model.fields,help:l10n_ar_arca_edi.field_account_bank_statement_line__l10n_ar_arca_edi_enabled
#: model:ir.model.fields,help:l10n_ar_arca_edi.field_account_move__l10n_ar_arca_edi_enabled
msgid "Only used to control the visibility of the 'Solicitar CAE' button in the view: without it the button shows up on any posted invoice, even from a journal with no electronic point of sale."
msgstr "Solo se usa para controlar la visibilidad del botón 'Solicitar CAE' en la vista: sin esto el botón aparece en cualquier factura validada, incluso de un diario sin punto de venta electrónico."

#. module: l10n_ar_arca_edi
#: model:ir.model.fields.selection,name:l10n_ar_arca_edi.selection__account_move__l10n_ar_arca_result__r
msgid "Rechazado"
msgstr "Rechazado"

#. module: l10n_ar_arca_edi
#: model:ir.model.fields,help:l10n_ar_arca_edi.field_account_bank_statement_line__l10n_ar_arca_observations
#: model:ir.model.fields,help:l10n_ar_arca_edi.field_account_move__l10n_ar_arca_observations
msgid "Remarks returned by ARCA even on an approval (Resultado=A with Observaciones is not an error, it is an approval with remarks)."
msgstr "Observaciones devueltas por ARCA incluso en una aprobación (Resultado=A con Observaciones no es un error, es una aprobación con salvedad)."

#. module: l10n_ar_arca_edi
#: model_terms:ir.ui.view,arch_db:l10n_ar_arca_edi.view_move_form_arca_edi
msgid "Request CAE"
msgstr "Solicitar CAE"

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "The CAE can only be requested for a posted invoice."
msgstr "Solo se puede solicitar el CAE de una factura validada."

#. module: l10n_ar_arca_edi
#: model:ir.model.fields,help:l10n_ar_arca_edi.field_account_journal__l10n_ar_arca_edi_enabled
msgid "The journal issues electronic invoices through the ARCA WSFEv1 (domestic market). It requires the point of sale system to be 'Online Invoice' (l10n_ar_afip_pos_system = RLI_RLM)."
msgstr "El diario emite factura electrónica por el WSFEv1 de ARCA (mercado interno). Requiere que el sistema de punto de venta sea 'Online Invoice' (l10n_ar_afip_pos_system = RLI_RLM)."

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "There is no installed module able to request the CAE through the ARCA %(webservice)s webservice for document %(document)s."
msgstr "No hay ningún módulo instalado que sepa solicitar el CAE por el webservice %(webservice)s de ARCA para el comprobante %(document)s."

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "This invoice already has a CAE."
msgstr "Esta factura ya tiene CAE."

#. module: l10n_ar_arca_edi
#. odoo-python
#: code:addons/l10n_ar_arca_edi/models/account_move.py:0
msgid "Unexpected response from ARCA: no FeDetResp."
msgstr "Respuesta inesperada de ARCA: sin FeDetResp."

