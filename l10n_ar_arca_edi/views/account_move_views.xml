<odoo>
    <record id="view_move_form_arca_edi" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ar_arca_edi</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_l10n_ar_arca_request_cae"
                    string="Request CAE"
                    type="object"
                    class="btn-secondary"
                    invisible="not l10n_ar_arca_edi_enabled or state != 'posted' or l10n_ar_arca_cae or move_type not in ('out_invoice', 'out_refund')"
                />
            </xpath>
            <xpath expr="//field[@name='qr_code_method']" position="after">
                <field name="l10n_ar_arca_edi_enabled" invisible="1" />
                <field
                    name="l10n_ar_arca_cae"
                    invisible="not l10n_ar_arca_cae"
                    readonly="1"
                />
                <field
                    name="l10n_ar_arca_cae_due_date"
                    invisible="not l10n_ar_arca_cae_due_date"
                    readonly="1"
                />
                <field
                    name="l10n_ar_arca_result"
                    invisible="not l10n_ar_arca_result"
                    readonly="1"
                />
                <field
                    name="l10n_ar_arca_observations"
                    invisible="not l10n_ar_arca_observations"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
