<odoo>
    <record id="view_move_form_arca_edi_export" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ar_arca_edi_export</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qr_code_method']" position="after">
                <field name="l10n_ar_arca_is_export" invisible="1" />
                <field
                    name="l10n_ar_arca_tipo_expo"
                    invisible="not l10n_ar_arca_is_export"
                    required="l10n_ar_arca_is_export and state != 'draft'"
                />
                <field
                    name="l10n_ar_arca_permiso_existente"
                    invisible="not l10n_ar_arca_is_export or l10n_ar_arca_tipo_expo != '1'"
                />
            </xpath>
        </field>
    </record>
</odoo>
