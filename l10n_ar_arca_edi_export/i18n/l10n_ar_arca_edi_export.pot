#: code:addons/l10n_ar_arca_edi_export/models/account_move.py:0
msgid ""
"The total of this export invoice (%(total)s) does not match the sum of the "
"items (%(items)s). WSFEXv1 only carries items and total, with no field for "
"taxes, perceptions, cash rounding or early payment discount. Remove whatever"
" is adding up outside the items before requesting the CAE."
msgstr ""

