#. module: l10n_ar_arca_edi_export
#: model:ir.model.fields,help:l10n_ar_arca_edi_export.field_account_bank_statement_line__l10n_ar_arca_tipo_expo
#: model:ir.model.fields,help:l10n_ar_arca_edi_export.field_account_move__l10n_ar_arca_tipo_expo
msgid "TO BE VERIFIED: the mapping was not confirmed against the official ARCA specification for WSFEXv1 (Tipo_expo). Manual entry until that verification. See readme/ROADMAP.rst."
msgstr "A VERIFICAR: el mapeo no fue confirmado contra la especificación oficial de ARCA para WSFEXv1 (Tipo_expo). Carga manual hasta esa verificación. Ver readme/ROADMAP.rst."

#. module: l10n_ar_arca_edi_export
#. odoo-python
#: code:addons/l10n_ar_arca_edi_export/models/account_move.py:0
msgid "The total of this export invoice (%(total)s) does not match the sum of the items (%(items)s). WSFEXv1 only carries items and total, with no field for taxes, perceptions, cash rounding or early payment discount. Remove whatever is adding up outside the items before requesting the CAE."
msgstr "El total de esta factura de exportación (%(total)s) no coincide con la suma de los ítems (%(items)s). El WSFEXv1 solo transporta ítems y total, sin campo para impuestos, percepciones, redondeo de caja ni descuento por pago anticipado. Quite lo que esté sumando fuera de los ítems antes de solicitar el CAE."

#. module: l10n_ar_arca_edi_export
#. odoo-python
#: code:addons/l10n_ar_arca_edi_export/models/account_move.py:0
msgid "The unit of measure '%(uom)s' has no AFIP code. Set it before invoicing an export."
msgstr "La unidad de medida '%(uom)s' no tiene código AFIP. Configúrelo antes de facturar una exportación."

#. module: l10n_ar_arca_edi_export
#. odoo-python
#: code:addons/l10n_ar_arca_edi_export/models/account_move.py:0
msgid "This version of the module does not send the shipping permit detail (Permisos array of WSFEXv1), so declaring 'Permiso de embarque existente' = S is not possible: ARCA would reject the document for the missing detail."
msgstr "Esta versión del módulo no envía el detalle de los permisos de embarque (array Permisos de WSFEXv1), por eso no es posible declarar 'Permiso de embarque existente' = S: ARCA rechazaría el comprobante por falta del detalle."

