<odoo>
    <record model="ir.ui.view" id="view_company_form_arca_ws">
        <field name="name">res.company.form.l10n_ar_arca_ws</field>
        <field name="inherit_id" ref="l10n_ar.view_company_form" />
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <field name="l10n_ar_afip_start_date" position="after">
                <field
                    name="l10n_ar_arca_certificate_id"
                    invisible="country_code != 'AR'"
                    options="{'no_create': True}"
                    context="{'default_company_id': id}"
                />
                <field
                    name="l10n_ar_arca_environment"
                    invisible="country_code != 'AR'"
                    widget="radio"
                    options="{'horizontal': True}"
                />
            </field>
        </field>
    </record>
</odoo>
