<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_afipws_certificate_alias_form" model="ir.ui.view">
        <field name="name">afipws.certificate_alias.form</field>
        <field name="model">afipws.certificate_alias</field>
        <field name="arch" type="xml">
            <form string="AFIP Certificados">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        invisible="state != 'draft'"
                        string="Confirmar"
                        class="oe_highlight"
                        help="Confirm and generate Key"
                    />
                    <button
                        name="action_create_certificate_request"
                        type="object"
                        invisible="state != 'confirmed'"
                        class="oe_highlight"
                        string="Crear Solicitud de Certificado"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        invisible="state not in ('draft', 'confirmed')"
                        string="Cancelar"
                    />
                    <button
                        name="action_to_draft"
                        type="object"
                        invisible="state != 'cancel'"
                        string="Volver a Borrador"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet string="AFIP Certificados">
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                string="Compania"
                            />
                            <field name="type" string="Tipo" />
                            <field
                                name="service_type"
                                groups="base.group_no_one"
                                string="Tipo de Servicio"
                            />
                            <field name="service_provider_cuit" />
                            <field name="company_cuit" string="CUIT de la Compania" />
                        </group>
                        <group>
                            <field name="common_name" string="Nombre Comun" />
                            <field name="country_id" string="Pais" />
                            <field name="state_id" string="Provincia" />
                            <field name="city" string="Ciudad" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Ceritificados">
                            <field name="certificate_ids" />
                        </page>
                        <page string="Key" groups="base.group_no_one">
                            <field name="key" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_afipws_certificate_alias_filter" model="ir.ui.view">
        <field name="name">afipws.certificate_alias.filter</field>
        <field name="model">afipws.certificate_alias</field>
        <field name="arch" type="xml">
            <search string="AFIP Certificados">
                <field name="type" string="Tipo" />
                <field name="common_name" string="Nombre Comun" />
                <field name="company_id" string="Compania" />
                <field name="state" string="Estado" />
            </search>
        </field>
    </record>

    <record id="view_afipws_certificate_alias_tree" model="ir.ui.view">
        <field name="name">afipws.certificate_alias.tree</field>
        <field name="model">afipws.certificate_alias</field>
        <field name="arch" type="xml">
            <list>
                <field name="type" string="Tipo" />
                <field name="common_name" string="Nombre Comun" />
                <field name="company_id" string="Compania" />
                <field name="state" string="Estado" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_afipws_certificate_alias">
        <field name="name">AFIP Certificado</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">afipws.certificate_alias</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="Certificados"
        action="act_afipws_certificate_alias"
        id="menu_action_afipws_certificate_alias"
        parent="menu_afipws"
    />
</odoo>
