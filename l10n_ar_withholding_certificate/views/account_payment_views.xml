<odoo>
    <record id="view_account_payment_form_withholding_certificate" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_ar_withholding_certificate</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Field declared invisible because the button `invisible`
                     depends on it: Odoo only evaluates the modifier when the
                     field is present in the view. -->
                <field name="l10n_ar_supplier_withholding_ids" invisible="1" />
                <button
                    name="action_l10n_ar_print_withholding_certificate"
                    string="Print Withholding Certificate"
                    type="object"
                    class="btn-secondary"
                    invisible="not l10n_ar_supplier_withholding_ids"
                />
            </xpath>
        </field>
    </record>
</odoo>
